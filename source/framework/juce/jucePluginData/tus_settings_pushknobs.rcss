/* ---- layer buttons ---- */

.pushknobs-section {
	padding-top: 1em;
}

.pushknobs-layers {
	display: flex;
	flex-wrap: wrap;
	gap: 0.3em;
	padding-top: 0.4em;
}

/* fixed size and border in every state: switching layers never moves anything */
.button.pushknobs-layer {
	box-sizing: border-box;
	width: 2.6em;
	height: 2.2em;
	padding: 0;
	line-height: 2em;
	border-width: 0.1em;
}

.button.pushknobs-layer:checked,
.button.pushknobs-layer:checked:hover {
	background-color: rgb(40,140,190);
	color: #fff;
}

.button.pushknobs-layer:checked:hover {
	background-color: rgb(30,112,155);
}

.button.pushknobs-layer:checked:active {
	background-color: rgb(25,95,130);
}

/* the layer shown below while another one plays: accent border, same width */
.button.pushknobs-layer:editing {
	border-color: rgb(80,180,230);
	color: rgb(120,200,240);
}

/* ---- layer name: caption above the field ---- */

.pushknobs-layername {
	display: block;
	padding-top: 0.8em;
}

.pushknobs-caption {
	display: block;
	color: #fffa;
	padding-bottom: 0.3em;
}

.pushknobs-layername-edit {
	display: block;
	box-sizing: border-box;
	width: 18em;
}

/* ---- knob table ---- */

.pushknobs-tr-headline {
	font-style: italic;
	background-color: #0003;
}

.pushknobs-tr {
	height: 2.4em;
	vertical-align: middle;
}

.pushknobs-tr td {
	padding-left: 0.6em;
	padding-right: 0.6em;
	vertical-align: middle;
}

.pushknobs-tr:empty {
	color: #fff6;
}

.pushknobs-name {
	box-sizing: border-box;
	width: 100%;
}

.button.pushknobs-clear {
	box-sizing: border-box;
	height: 1.9em;
	padding: 0 0.8em;
	line-height: 1.7em;
}

/* the knob number needs little room, names need a lot */
.pk-col-knob { width: 2.5em; }
.pk-col-param { width: 13em; }
.pk-col-name { width: 13em; }
.pk-col-value { width: 6em; }
.pk-col-clear { width: 5em; }

.pushknobs-hint {
	color: #fffa;
	font-style: italic;
}

.pushknobs-presetmode {
	padding-top: 0.8em;
}
